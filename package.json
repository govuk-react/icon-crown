{
  "name": "@govuk-react/icon-crown",
  "version": "0.2.0",
  "description": "The GOV.UK crown and logotype as React components, matching govuk-frontend",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "author": "Alasdair McLeay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govuk-react/icon-crown.git"
  },
  "bugs": {
    "url": "https://github.com/govuk-react/icon-crown/issues"
  },
  "homepage": "https://github.com/govuk-react/icon-crown#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "domhandler": "^6.0.1",
    "govuk-frontend": "6.6.0",
    "htmlparser2": "^12.0.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
